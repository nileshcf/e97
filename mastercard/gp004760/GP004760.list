       318           ******************************************************************                                              
       319           * CURSOR DECLARATION TO GET THE CAB AND TXN CAT CD                                                              
       320           ******************************************************************                                              
       321                                                                                                                           
       322                EXEC SQL                                                                                                   
       323                        DECLARE CABTCCEXT_CSR  CURSOR WITH HOLD  FOR                                                       
       324                                                                                                                           
       325                        SELECT A.CAB_CD,                                                                                   
       326                               A.AUTH_TXN_CAT_CD                                                                           
       327                        FROM TGPAITB A                                                                                     
       328                        WHERE A.REC_STAT_CD = 'A'                                                                          
       329                        AND   A.EFF_TS =                                                                                   
       330                       (SELECT MAX(A1.EFF_TS)                                                                              
       331                        FROM TGPAITB A1                                                                                    
       332                        WHERE A.CAB_CD    = A1.CAB_CD                                                                      
       333                        AND   A1.DEL_SW   = 'N'                                                                            
       334                        AND   A1.EFF_TS  <= CURRENT TIMESTAMP -                                                            
       335                                            CURRENT TIMEZONE)                                                              
       336                 ORDER BY CAB_CD                                                                                           
       337                END-EXEC.                                                                                                  
