   000355               * CURSOR DECLARATION TO GET THE CAB AND TXN CAT CD                                                           
   000356               ******************************************************************                                           
   000357                                                                                                                            
   000358               *****EXEC SQL                                                                                                
   000359               *****        DECLARE CABTCCEXT_CSR  CURSOR WITH HOLD  FOR                                                    
   000360               *****                                                                                                        
   000361               *****        SELECT A.CAB_CD,                                                                                
   000362               *****               A.AUTH_TXN_CAT_CD                                                                        
   000363               *****        FROM TGPAITB A                                                                                  
   000364               *****        WHERE A.REC_STAT_CD = 'A'                                                                       
   000365               *****        AND   A.EFF_TS =                                                                                
   000366               *****       (SELECT MAX(A1.EFF_TS)                                                                           
   000367               *****        FROM TGPAITB A1                                                                                 
   000368               *****        WHERE A.CAB_CD    = A1.CAB_CD                                                                   
   000369               *****        AND   A1.DEL_SW   = 'N'                                                                         
   000370               *****        AND   A1.EFF_TS  <= CURRENT TIMESTAMP -                                                         
   000371               *****                            CURRENT TIMEZONE)                                                           
   000372               ***** ORDER BY CAB_CD                                                                                        
   000373               *****END-EXEC.                                                                                               
