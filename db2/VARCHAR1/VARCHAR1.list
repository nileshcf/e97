   000368               *    Execute the query to grab one row given the input values                                                
   000369               *****EXEC SQL                                                                                                
   000370               *****     SELECT ID                                                                                          
   000371               *****     INTO                                                                                               
   000372               *****     :VCHAR1-ID                                                                                         
   000373               *****     FROM VCHAR1                                                                                        
   000374               *****     WHERE FIRST_NAME = :VCHAR1-FIRST-NAME                                                              
   000375               *****     AND LAST_NAME = :VCHAR1-LAST-NAME                                                                  
   000376               *****     AND NICK_NAME = :VCHAR1-NICK-NAME                                                                  
   000377               *****     FETCH FIRST 1 ROW ONLY                                                                             
   000378               *****     END-EXEC.                                                                                          
