   000006                WORKING-STORAGE SECTION.                                                                                    
   000007               *----------------------------------------------------------------*                                           
   000008               * This test case is to represent an issue found at EDJ. What     *                                           
   000009               * happens is they have a VARCHAR column in their database and    *                                           
   000010               * they query this column with a length that changes based on the *                                           
   000011               * input data. CloudFrame needs to support the dynamic lengths of *                                           
   000012               * VARCHAR                                                        *                                           
   000013               *----------------------------------------------------------------*                                           
   000014                                                                                                                            
   000015               * Include SQLCA as this is a DB2 program                                                                     
   000016               *****EXEC SQL                                                                                                
   000017               *****INCLUDE SQLCA                                                                                           
   000018               *****END-EXEC.                                                                                               
   000019                 01 SQLCA.                                                                BLW=00000+000         0CL136      
   000020                    05 SQLCAID     PIC X(8).                                              BLW=00000+000,0000000 8C          
   000021                    05 SQLCABC     PIC S9(9) COMP-5.                                      BLW=00000+008,0000008 4C          
   000022                    05 SQLCODE     PIC S9(9) COMP-5.                                      BLW=00000+00C,000000C 4C          
   000023                    05 SQLERRM.                                                           BLW=00000+010,0000010 0CL72       
   000024                       49 SQLERRML PIC S9(4) COMP-5.                                      BLW=00000+010,0000010 2C          
   000025                       49 SQLERRMC PIC X(70).                                             BLW=00000+012,0000012 70C         
   000026                    05 SQLERRP     PIC X(8).                                              BLW=00000+058,0000058 8C          
   000027                    05 SQLERRD     OCCURS 6 TIMES                                         BLW=00000+060,0000060 4C          
   000028                                   PIC S9(9) COMP-5.                                                                        
   000029                    05 SQLWARN.                                                           BLW=00000+078,0000078 0CL8        
   000030                       10 SQLWARN0 PIC X.                                                 BLW=00000+078,0000078 1C          
   000031                       10 SQLWARN1 PIC X.                                                 BLW=00000+079,0000079 1C          
