ױסששפנףסקׁׂÙַזֳֹׁחֲִ׳׳ֲֲַׂ׳ֹײָגֲ׳גֵחהזִױיײױג״ֵָגטÙױויודָֹהֹגׂ׃דװגֵÙֹודÙִטג׳״ֹױֳחגסשרננסנצטחײִװֹÙחװחֲֹׂדײגהװֶָה״ֲײִַׁ״דָֹיג׳גֶַגֲִֹׂדחֹד׃טדÙהׂ״ײײÙהֲװֲַײװ״ח״ַֹֹֹׁ׳סשפפנףנשײ׃ד׃װײ׃װדֹױ״זדֲֵההֹֹיט״Ù״ִֵזהÙ׃ֳָטװטׂ׳טָוֹדÙַÙױׁױֱ׃טֲִֹֹױֳׂגגֲגֹׂהװחױֱַַסשרסנףנעײײÙֹװִגײֹׂיÙטזֵָױ׃ָָװײׁׁׂÙזױױגװדיֱִָהױה״״ֶ׃Ùֹדֹהװִֵֵַֹֹהגזגײֱֳֵחחד׳יװודֱסשקענפעצהׂױַהֶֶזֱַטׁÙדÙהִֵױֲֳהט״ׁװִהה׃גÙ׃ַזוטֶדדױ׳ָ׳ױטװַיװַׂחחגגזַׂײַֹ״ֵהד׃ײֵֶ׳זסשעקסנסףָױ׳ֲַֹוײ״ײײגזÙװהֳיִזגי״חזז׃טגװהטׂגׁטטׁײהגÙֹ׃וÙֵהױױו׳ÙגחוגהױחÙֵ׳ׂ״׳דֳִױזַסשקפנפעףֹ״ֹהגוֹדֳ׳ױׁזגױװװֶטַהדÙ׃ֱֵֶָזׂדטױח״ׁחגױה׳גׁׂ׳ױזֲֹײהֵֶֶגֲֶױÙÙטחגֶזֶטחוֵגגסשששנקנס׳ַ״ֶׁׂהֲ״ÙֱױÙÙהֵגג׳״דÙײֲֶֹׁװהההדױֳהֹטַגטגגװÙֳַַׁיװָחטהױ״ה״ױגֳׂחטֹו׳װההÙױעננפנסעסזז׃ֳָÙֹג״ױטֳÙהח׳׃ֲֹװד״׳ג׃׃ֶַױÙֶחָדהֳױֶ׃וׂ׃ִַָגגהױגַױִגגִֹױטֶֶׁÙֶײהֶÙזױֶֶסשסקנשעץזװוָװַׂגֲֲגֱ״ÙÙֳװ״ההÙִחדֶײחֹױÙֵÙֹהװַ״ִטִָהױ׃יÙױדי׃גֳטׁהדֶָָÙהזדױגׂװַ׃װדִענסףנססנÙִַַַַָחוָחױֹיִׁײָטÙױדווׁׂ״׃ױגז״ײהװגהÙױױׂ׃ֶטֱיוױ״ַװÙגׁ׳הֶֶדגהיטֹהדה׃ױױזָסשסרסעעקדִגִÙגÙÙֶדו״ׂזחÙהחדֲֶ״גׁזױ״ֶָÙ׳הױֵהטׂÙדױֲ׃׳״יגחׁÙױהװטטֱֵֶ״׃ױחװֳֶגוטױזִהײסשררנקסש״ÙֱױÙÙהֵגג׳״דÙײֲֶֹׁװהההדױֳהֹטַגטגגװÙֳַַׁיװָחטהױ״ה״ױגֳׂחטֹו׳װההÙ׳ו׳ֵ״חַיֹסשנפנרספֶ׃ֱׂחׂׂוװז׃ה׳ױגֵׁ׃גודֲװזוױִֹױֱ״טװָזדװג״׃גװÙײׁÙטײ׳ׂ׳ֲׁׂ״Ùֹװהגױױדװװטִהֳוױגסשפףנקנשֶגחֹדד׳טׁ׃ׂוֵױַגֲהַזׂד״דטָֹזזֳָֹדדֵ׃װײֵחזׂזהÙההחֳ׃הױֳֵַׁד״ֳז׳ט״װ״Ùטזָיָוסשרשנףסעדגײֱדֶװַָוײ״הװÙטֶ׳״ײֵַדטד״ההÙִדװֶגדװד״׃ֲָֹהחÙהגגׂױײÙׂדÙֵ׃ױהַ׃׃דׂגחֲײװײÙÙסשנפנקעףִהױֹגֶוׁÙגוז״ֳװװֶײ׃חײ״ֱֲהֱױִ׃ֱֲׁÙֹׁוÙÙטׁױװֱגיגֲײֵדהז״ֵװ׳װֶטׂÙֶד״טֲֳֶֶהחזענסקנקעקָֹדײֱÙֵײױהֹֹÙַהיÙׁ׃זדטחֵׂטֶֹױֱָ״Ùײדֱׁג׳ֱג״ֶודֹ׳ֹוטהִחהױֵד״ׂחגיÙֱֳִֵֵֶׁׁטסשנענשעצװזׂזױׁ׃הגֳחד׳חגׂטד״דדֲַÙֳױֲֵהד׃׳ִ״ַהחֵדױטזג׃הֶֶױ׃הױ׳ױÙֳזֶֶׂטֱײֱטֲׁװדֲׁ׃הסשסנסנסר״ֹדזֱ׃װחװװֲֲַההײ׃חדֶױי״ד״גױִ׳ÙÙ״ֵזֳ׳הױָװההֳזֲו׃ִָיױוÙײזזגֹזױחֲ״דה׳ÙטטוַהסשרצנץססוזÙֹÙָ׃ה״ֶגחדֵׁ׳ֱוֲ׃חדױֲֵֹטוה׃ׁװֲווהוֵ׃ׂהױׁדחָהדװׁחײװָחֹׁחֵֵַׂׂוזחֹײÙהג״סשףענץערÙ׳ֹÙָגה״ֱגÙטֲגִװחִַֹדזֲטטָוװהֹחטױיֹׂױׁהװ׃ֲֵ״ֵ׳וֹדחה׳והױדֵדֱַֹÙדגׁװטהֶָױחענסשנרעקויֶד׃ױזגגֳִֹֹ׃ֵֶַׁײֲׂÙ״טדֵזזֱֳָֹׁװײׁדזודו׳ו״ײװױֲׁÙֲֳיוױזװהׁח׳װֶׂהִֶֹדֵׁגסשסצססענױֶׁוט״ֶׂײִֵַַָ׳ֳ׃ֳַטװÙחֱֲדטטַָױַ״ִױזׂױגֳÙֵַװטֶַֹטÙהֶֹׂ״וÙֳָגֲחײֱֵַהד׃Ùֶהסשעץנקעץזדֲַז׃״ÙװגָױיוÙטוזױ׳ח׃Ùױײחׂװ׃ׂ׳ֹׁ׳יֶגַַֹֹׂױגהדדֵ״װוגִ׳וַױִַז׃׳װד״ֹװחֹגֹ