ִסששףנרעףֶֶװִׂחטװדחֳָהֲֶַׂדיױֹי׃ֲׂהדהחװֱַ׳טיֹגגחהִָÙ׃ֳה׳חַדװױח׃י״ַז״ֹ׳װֳָÙױדױדÙֹײסשנץססענֱָׁװײׁדזודו׳ו״ײװױֲׁÙֲֳיוױזװהׁח׳װֶׂהִֶֹדֵׁױװײ״ֳׂטװָזָ׳זװ׃הַדִדטוֱ״ָחַװׁוגעננפנרנקַױדחֱֲוהׁױוזֵֶ׳ֲֶׂטחױגַדֶַטׁחו״ײ״ֳׁחױֵחטזדֱֹגדוÙִַַַַָחוָחױֹיִׁײָטÙױדווגסשףץנץנש׃ֶװַהÙײÙֳהִÙַֹױײײֳÙיױגַדגהֱַדיׂוֱװֶזהֲװָדדֹדוװדײ״זÙֲֵֹײֱַ״ֱֶׂהגױ׳גֱֶֹׁׂדענסקנפעסוÙװ׃ֹט׃טֶגזָוÙ״Ùזוֹז׳Ùַׂ׳ֱֳ״״ֶֶח׳וֵֶֹהחחÙֶהױגֹײװֹזִדֲֲױחֱֲדײ׃װהדהַזֹ״Ùװ״ענעננשענטוֳִ׳ÙוהֲֳװהזִֶׂגזױהִׁהױֹגֶוׁÙגוז״ֳװװֶײ׃חײ״ֱֲהֱױִ׃ֱֲׁÙֹׁוÙÙטׁױװֱגיגֲײֵדוסשפרנקעץחדהדדֳֵוÙװװח״׳ֲֳג׃ׁױװהֱַײגֳ׳׳Ùהֵ״ׂ׃ױדזÙִװחֱָדֱֲֹׂג״ָװװגח׃ױחה׳דדױװ׳ױװÙֶטֹסשרצנקנשױחוװױ׃גוחזט׳ִההׁױֱװ״װֶגֶיגÙגטדÙ׃ֱֳהֳ׃ֳֶָׂױגװחוׁהזח״דÙהױ׃ֱֳׁ׳גַׂוֲֲֳֶַָֹױענסשנצערחÙגָָזָזֲֲֳֵדֹׁטיױֱׂװוׂהדױדֶֹגגֲֶֹֹדׁג״גֲֲֲִֵָֹדהָהֵײטָוײֶװָזהח׳ׂױֳח״ֲחָסשרקנעססֲֶוָ״הטֹ׃׳ױֱֳֶֹזֱֱֳַ׃זׁׂÙ׃דִׁדה׃ױָׂױ׃יֲֶװגָׂÙׂהט׃ׁװֶױׂוִֶׂהױֵזֳֳזַֹזודÙֳסשעקסעסצֵֹ׃גׁוֳװדיׂז״טׁÙז׳Ùװ׳גֳִַֹײֲױדױָׂÙחױׁÙֹׂזׂ״ֹדחָודָֹהֳיהחהֹױיָגחגחהֱֲֵהגדסשססנקנרדוֲזִׂחגַ״ֵגִÙחֹׂדױַׂגֵֹײÙ׃ויׂדױׁ׃ווׂהזֳװִ׳ֲֶ״טיוײֱחטדדֲ׃ֹױחדדזײ׃ד׃װײ׃װֹסשפץנפנרװֳױגגיהִװֶדַוטױֲיהֵױֹ״ÙײגדÙחַÙ׃Ù׃ױֱױ״ֲ״ַׂװ׳׃ÙֳִÙיוגזװֶÙיִֵׂגװׁײ״דױÙ׳ֹ״ֹֹענסננשסץזגי״חזז׃טגװהטׂגׁטטׁײהגÙֹ׃וÙֵהױױו׳ÙגחוגהױחÙֵ׳ׂ״׳דֳִױזחזÙׁװגַװזחזÙ׃ַגÙהזחׂסשסקנצנעטױׂױֳÙײחז״טֳהֱֲִ׃גחהזױÙהו׃ײדֳÙֳֶָׁװװג״זטָׂÙ׳װדגֱטַ״טײהׁׂטטֶÙײװÙֹױז״דױֶ״ַסשנרנצעפהֱֲÙֱׁׁׂגהֶװָװײÙטַגח׃ָױֱחהװיגײחגׂװזֱֲֳׂגדװֲטגִחװהװֲֲוױֶידהדדׁה׳Ùזדֳֵֶױג׃סשננסענעָװוֶטגױחוװױ׃גוחזט׳ִההׁױֱװ״װֶגֶיגÙגטדÙ׃ֱֳהֳ׃ֳֶָׂױגװחוׁהזח״דÙהױ׃ֱֳׁ׳גַׂוֲַענסשנץססדֹÙחחÙדגוÙװײדֱׂגֶ׳גÙÙַ׃ׁ׳ײוֳײזדֵֶ״הױֲגֵ׳ֹ׳׃ײװֶגזדד׃ֱִֹדגִהידֵֵטװ׳׳ׁׂטוֳװסשרשנףנקחׂױׂוÙ׳ײֳזזגֱֲָגגד׳וַװֲִֹׂדָהגװֲÙדױהזחױֱֵׂÙִגדֶגֹהױֹחױׁחהװג״ִיÙׁ׳דֱֹזװדװעננףסענצִדה׃יֶױÙָױֱחגÙַװוגגׂ״ג׃גהֹ׃חזֶ׃ֶÙױטױִֶׂההÙױֱױׁÙÙײÙ״Ùֵ״״חÙז׳הוֳזָגויהַחגױסשףענצעפÙ״גֹ״ײֳֳֹהגטÙÙװִױזװהֱֲה׳חײװֳÙטדחֹֹטײ׳חוגֵגֱוָ״׳גֹ׃גײֳַ׃זזַיחֵד״ֱֶֹהÙ׳ֱָׁסשררנענףחֱ׃ֹײדÙוÙֹחֳֵַַ״ׁ׃״ד״דֱֲִִַׁחֵחױגֲׁו״װװֲִֹ״טו׃הױִָחװ׃ױװֶדֳַחױÙיִטטֶטההֵדעננצנצסשֳטײדֵֹד׃ׁו״זֳׁוגדחזײײÙֹװִגײֹׂיÙטזֵָױ׃ָָװײׁׁׂÙזױױגװדיֱִָהױה״״ֶ׃Ùֹדֹהװִֹֹגסשףרנשנס׳טִו״ֲִִױהֲױײײױֹÙגײג׃וחהדָÙחֹױגײֱÙױÙֳׂגֵױױז״ֳֹהטױױֳױÙÙׁ׃ֳטדטטהיװהײׂהַװֶ׃סשסץסנספחׂדװג׳ױזװדױטֵחהדדֲÙײ״גטֱ״טח׃ֱֲִֶַֹױֳָוׂװֳ״ֳו׳דײÙÙגִֹװהטֳדװזׂזÙטִזהֹזוח״ױסשקפנקעץÙֶֹװֵֶֶׁח״יזחֳחִִײֳױװזגÙטׁׂ׃ֱÙטÙַז״״וֱזֵיט״הַיֱֳִָׂׂחג׃ײÙ׳זÙֲִה׃וההטחֶהÙסשצףנעסףװחײחוֹֹזֹגײָֹֹגַזיהגזַÙ׃׳ָחטיחײֳֹÙהװידַחֱגחײזײֶד׳ֵגטוױָÙÙױÙ׃ֵֶַׂגֹׂ״דדֱֹסשערסנעץהחגחֶֶױ״גֱֳִִֵׁױײױוטַ׳ִחהױִיׁגהֶ׳ֶ׳ֱ׳גֱׁגֳֳזֲֹֹֹׂÙזֶׁ׳הֹװֱֵַ״ָײֱ״׳װׁגזֱזענסשנףנעֶוÙֶ׃גהׁׁ׃ֱד׃גגֱֹֹזײױ״ױֵױו״טֱזװָדֵֶָגױױׁ׳ֹײדׁױוÙֶדדזװֹֹÙהֵגטֹ״וֵֹזגָהֱֲזסשרקנשנצהÙטוױÙ׳וװזזִזוחַװוׂהו׳הװֱÙֹחÙֲֳׂגׁײגÙֳַװָװֹהֶטײׁׁ״חֲָׂחָה׃ִױ׳וװִגי׳חִָÙױסשנקנצסעֲֵֹטוה׃ׁװֲווהוֵ׃ׂהױׁדחָהדװׁחײװָחֹׁחֵֵַׂׂוזחֹײÙהגÙהִהֶהָÙגױההײ״ֹױ׃ֳֹד׳דװַעננצססנעױÙ״׃׃ֳַיÙײֹֹײֱִַטײֵֹ״׃ד׃ײׁט״ׁװטגװדׂטׂגֹׂד׃ז״טֲװֹֹ׃ֲֳײװוÙ׳׳׳ײֱ׃חוגׂוגֹ׳הַסשססנקסש״׃׃ִֵָָׂ׃ױׂהׂׂיֱױֲֹוֹ״טי׳Ùֶחטַָ״ֲ׳זֵֹׂÙהֵגחֲִָׁ״ָטדÙטױ״ױֱׁיֶֹÙÙהַ״ֶװחײחײסשררנץנעװַָוײ״הװÙטֶ׳״ײֵַדטד״ההÙִדװֶגדװד״׃ֲָֹהחÙהגגׂױײÙׂדÙֵ׃ױהַ׃׃דׂגחֲײװײÙֶÙׂוגדױסשעשנץנץ״ֶׁׂהֲ״ÙֱױÙÙהֵגג׳״דÙײֲֶֹׁװהההדױֳהֹטַגטגגװÙֳַַׁיװָחטהױ״ה״ױגֳׂחטֹו׳װההÙ׳וֲסששעסעערֵוֱִׁײגֳחֳ׳ÙטׁׂÙַזֳֹׁחֲִ׳׳ֲֲַׂ׳ֹײָגֲ׳גֵחהזִױיײױג״ֵָגטÙױויודָֹהֹגׂ׃דװגֵÙֶסשרץנףנרחֵדװֲֹגֹטÙײֱהֶׂג׳ׁ׳ח׃ֳחִװֹ׃הֱ׃ִדדחהַׂÙֳדÙוױֳחׁײֶַÙױז׃װִׁדטזֱחױֱוההÙױוֲהׁסשץץנרסףֲֳֶ׳Ù׃דÙֱײֹײֲׁוֵֹֹגׁטדֲגגיÙִֶַׂטֹדח׃ֶװַהÙײÙֳהִÙַֹױײײֳÙיױגַדגהֱַדיׂוֱװֶזֳסשץשנססרִדטָזהװזֱ״ֹט׃הװַ״יײֱֹײֲֶדָֹװֲֹֹׂט״ֹׂגזֱֹׁטַׂיִח׳׃ײַהזה׃טוֳהֵָֹױגױֱַװװװ׳װענסקנעעעֲהחױוֶחױהדהטװׂ׳ײÙחג׃ִָָחֲִֵ׃הֵֹױֱטֲֶָדֲִטטװַײֶָÙװֵט׳ÙטדֲטֳÙֱֲֲטׁחגֹׂױגֲזסשףשססנרÙÙדױזױִײדִטÙֳזִגײדֱוֹטױֶױֱÙָיוװדוÙװÙִוױט״דױה״הֱױׂחדֹגחֳֳײָױװײָד״ײֲֲיגÙִװעננענצסעחײֵֹוגחװױֲֲׁגׂזÙױֹוױ׳ִׂׂײֲֶחֵ״גחדדÙִזדזוװָÙגֶהװÙָדׁג׃דוהװג׃זֵודֵÙ׳׃הד״ֶײסשףףנעסקÙֳֶָׁװװג״זטָׂÙ׳װדגֱטַ״טײהׁׂטטֶÙײװÙֹױז״דױֶ״ֶדיו׃ַׁױהזװדֱִױֱÙטזֵֹֹװÙזׁדֹגֳסשסענפנף׳ֱדויֵָֹֹװֶָÙֲַֹחוגִַׂױװַדֳגֳֵדטגהֵׁהױֲה״ױװוֹֹ״ׁױטדחֶ׃Ùהװ׃זֶטהֲִחÙײÙֹי׳ִסשעננץסףח״ַֹֹֹׁױד׳װ׃װהוײדײווֵ׃ִִגװװװװ׃ֵגווִָֹׁׁׁׂטֹֹ׃ָגֲטזוזֶז׃זדװָחֲגג״ÙֳÙױטטִגענסףנצסנִׂװי״ׂדױזֱֹֹדגֱִטגה׃ײ׃גׂÙװױהֱֱֱַַׁׁדהױִׁׂװֱֳֵֹװÙÙױׂוױזִ׃ִַׂױוֵÙזז׃ֳָÙֹגׁסשפסנצנפװ׃Ùֲ׃ווגװטֳװֳׁׁגױױדטגִײֹהֱִֶַֹׁזזֹֹדױ׃״ׂד״ֶָÙ׃ױחטֹדוÙױ״חוֹזֲװוױֶהגזהÙגÙיעננענףסרִָהױ׃יÙױדי׃גֳטׁהדֶָָÙהזדױגׂװַ׃װדֲַ׳הÙױױײ״ההחחֳטדההוזװההֱחטײײַÙטֹדגגֶגׂׂדסשףעסנערװג׃ׂדטגֲַָֹיֱוׁ״חטׁױטװדגדד״ֳַֹגטׁטױדֹוה״״ׂטִָי׃ִזׂחֹׁחױדײֱׂװׁײטֵחֱֹÙטװֳָסששענץסנ׳ֵ׃ֶױַײֳִֹדׁױד״ֵיֲהֳוװׂױֱװ״װװַׁדׁטֱֶױÙױׂ״ה״ײֱײֳִׂטׁטÙֵÙזײ״ױױֱױֹגײחגדֹ׳ִ